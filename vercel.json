{
  "version": 2,
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/boot"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/boot"
    },
    {
      "source": "/((?!api/|r/).*)",
      "destination": "/index.html"
    }
  ]
}
