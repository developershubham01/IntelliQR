{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/r/:path*",
      "destination": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
