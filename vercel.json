{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/boot"
    },
    {
      "source": "/r/:path*",
      "destination": "/api/boot"
    },
    {
      "source": "/((?!api|r|assets|favicon|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
