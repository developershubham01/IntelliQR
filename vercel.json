{
  "version": 2,
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/boot"
    },
    {
      "source": "/r/:path*",
      "destination": "/api/boot"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
